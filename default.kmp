;; Use this for testing
;; Quotes around rulestores are used to preserve case for Xx bit positions.
(sessiondata-from
  '(SD(DS((DOM
            (ACT ("[XX/XX/XX/Xx]"))
            (ACT ("[XX/XX/Xx/XX]"))
            (ACT ("[XX/Xx/XX/XX]"))
            (ACT ("[XX/Xx/XX/Xx]"))
            (ACT ("[Xx/XX/XX/XX]")))
       (DOM
            (ACT ("[XX/XX/Xx]"))
            (ACT ("[XX/Xx/XX]"))
            (ACT ("[00/Xx/XX]"))
            (ACT ("[11/Xx/XX]"))
            (ACT ("[Xx/XX/XX]"))
            (ACT ("[01/XX/XX]" "[00/XX/Xx]"))))
      )
      (SR (RC (r110X r110)) -1)
      (SR (RC (r11X1 r110))  2)
      (SC (s0101 s111))
  )
)

