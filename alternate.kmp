;; Use this for testing
;; Quotes around rulestores are used to preserve case for Xx bit positions.
(sessiondata-from
  '(SD(DS((DOM
            (ACT ("[00/XX/XX/Xx]")) ; Set up rule that may produce asymmetric steps.
            (ACT ("[XX/XX/Xx/XX]"))
            (ACT ("[XX/Xx/XX/XX]"))
            (ACT ("[Xx/XX/XX/XX]")))
        )
      )
  )
)

